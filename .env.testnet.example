# =============================================================================
# TESTNET CONFIGURATION TEMPLATE
# =============================================================================
# Copy this file to .env.testnet and fill in your testnet wallet addresses
# DO NOT use production wallets for testing!

# =============================================================================
# TRON TESTNET (Nile) - USDT TRC-20
# =============================================================================
DEPOSIT_ADDRESS_TRC20=your_testnet_tron_address
TRON_PRIVATE_KEY=your_testnet_tron_private_key

# =============================================================================
# BSC TESTNET - USDT BEP-20
# =============================================================================
DEPOSIT_ADDRESS_BSC=your_testnet_bsc_address
BSC_PRIVATE_KEY=your_testnet_bsc_private_key

# =============================================================================
# TON TESTNET
# =============================================================================
DEPOSIT_ADDRESS_TON=

# =============================================================================
# BYBIT (not used for tests)
# =============================================================================
DEPOSIT_ADDRESS_BYBIT=

# =============================================================================
# API KEYS
# =============================================================================
# BscScan API: https://bscscan.com/apis (for testnet: https://testnet.bscscan.com/apis)
BSC_API_KEY=your_bscscan_testnet_api_key

# =============================================================================
# HOW TO GET TESTNET TOKENS
# =============================================================================

# 1. TRON Testnet (Nile):
#    - Faucet TRX: https://nileex.io/join/getJoinPage
#    - Import private key to TronLink
#    - Get testnet TRX
#    - Exchange for USDT via testnet DEX

# 2. BSC Testnet:
#    - Faucet BNB: https://testnet.binance.org/faucet-smart
#    - Add BSC Testnet to MetaMask:
#      Network Name: BSC Testnet
#      RPC URL: https://data-seed-prebsc-1-s1.binance.org:8545
#      Chain ID: 97
#      Symbol: BNB
#      Explorer: https://testnet.bscscan.com
#    - Import private key
#    - Get testnet BNB

# 3. BscScan API Key:
#    - Register at https://testnet.bscscan.com
#    - Create API key in profile
#    - Insert above

# =============================================================================
# SECURITY NOTES
# =============================================================================
# ⚠️  THESE ARE TESTNET WALLETS! DO NOT SEND REAL FUNDS!
# ⚠️  FOR PRODUCTION CREATE NEW WALLETS SECURELY!
# ⚠️  KEEP PRIVATE KEYS SAFE!
# ⚠️  DO NOT COMMIT .env.testnet TO GIT!
