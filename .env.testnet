# TRON Testnet (Nile) - USDT TRC-20
DEPOSIT_ADDRESS_TRC20=your_testnet_tron_address
TRON_PRIVATE_KEY=your_testnet_tron_private_key

# BSC Testnet - USDT BEP-20
DEPOSIT_ADDRESS_BSC=your_testnet_bsc_address
BSC_PRIVATE_KEY=your_testnet_bsc_private_key

# TON Testnet (пока не реализовано)
DEPOSIT_ADDRESS_TON=

# Bybit (не используется для тестов)
DEPOSIT_ADDRESS_BYBIT=

# API ключи (получить на сайтах)
# BscScan API: https://bscscan.com/apis (для testnet: https://testnet.bscscan.com/apis)
BSC_API_KEY=получите_на_bscscan_com

# =============================================================================
# ИНСТРУКЦИИ ПО ПОЛУЧЕНИЮ ТЕСТОВЫХ ТОКЕНОВ
# =============================================================================

# 1. TRON Testnet (Nile):
#    - Faucet TRX: https://nileex.io/join/getJoinPage
#    - Импортируйте приватный ключ в TronLink
#    - Получите тестовые TRX
#    - Обменяйте на USDT через testnet DEX

# 2. BSC Testnet:
#    - Faucet BNB: https://testnet.binance.org/faucet-smart
