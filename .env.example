# =============================================================================
# ENVIRONMENT CONFIGURATION TEMPLATE
# =============================================================================
# Copy this file to .env and fill in your actual values
# DO NOT commit .env to version control!

# =============================================================================
# DJANGO SETTINGS
# =============================================================================
SECRET_KEY=your_django_secret_key_here
WEBAPP_URL=https://your-domain.com

# =============================================================================
# TELEGRAM BOT
# =============================================================================
TELEGRAM_BOT_TOKEN=your_telegram_bot_token_here

# =============================================================================
# TOKEN ADDRESSES (BSC Mainnet)
# =============================================================================
MATTER_TOKEN_ADDRESS=your_matter_token_address
IDEA_TOKEN_ADDRESS=your_idea_token_address
USDT_TOKEN_ADDRESS=0x55d398326f99059fF775485246999027b3197955

# =============================================================================
# APPLICATION WALLET
# =============================================================================
APP_WALLET=your_app_wallet_address
APP_WALLET_PRIVATE_KEY=your_app_wallet_private_key

# =============================================================================
# API KEYS
# =============================================================================
# Moralis API: https://moralis.io/
MORALIS_API_KEY=your_moralis_api_key

# TON API: https://toncenter.com/
TON_API_KEY=your_ton_api_key

# Infura API: https://infura.io/
INFURA_API_KEY=your_infura_api_key

# BscScan API: https://bscscan.com/apis
BSC_API_KEY=your_bscscan_api_key

# WalletConnect: https://cloud.walletconnect.com/
WALLETCONNECT_PROJECT_ID=your_walletconnect_project_id

# =============================================================================
# DEX CONFIGURATION
# =============================================================================
PANCAKESWAP_ROUTER_ADDRESS=0x10ED43C718714eb63d5aA57B78B54704E256024E
PANCAKESWAP_ROUTER_ADDRESS_TESTNET=0x9Ac64Cc6e4415144C455BD8E4837Fea55603e5c3

# =============================================================================
# RPC URLS
# =============================================================================
BSC_RPC_URL=https://rpc.ankr.com/bsc

# =============================================================================
# DEPOSIT ADDRESSES
# =============================================================================
# TRON - USDT TRC-20
DEPOSIT_ADDRESS_TRC20=your_tron_deposit_address
TRON_PRIVATE_KEY=your_tron_private_key

# BSC - USDT BEP-20
DEPOSIT_ADDRESS_BSC=your_bsc_deposit_address
BSC_PRIVATE_KEY=your_bsc_private_key

# TON
DEPOSIT_ADDRESS_TON=your_ton_deposit_address

# Bybit (optional)
DEPOSIT_ADDRESS_BYBIT=

# =============================================================================
# WITHDRAWAL CONFIGURATION
# =============================================================================
# Private keys for sending funds during withdrawal
WITHDRAW_PRIVATE_KEY_TRC20=your_tron_withdrawal_private_key
WITHDRAW_PRIVATE_KEY_BSC=your_bsc_withdrawal_private_key

# TronGrid API Key (optional, for better stability)
# Get it at: https://www.trongrid.io/
TRONGRID_API_KEY=

# TON Wallet Configuration
WITHDRAW_TON_MNEMONIC=your_ton_wallet_mnemonic_24_words
USDT_TON_CONTRACT=EQCxE6mUtQJKFnGfaROTKOt1lZbDiiX1kCixRv7Nw2Id_sDs

# =============================================================================
# SECURITY NOTES
# =============================================================================
# ⚠️  NEVER share your private keys or mnemonics!
# ⚠️  Store this information securely
# ⚠️  Use separate wallets for testing and production
# ⚠️  Keep backups in a safe place
# ⚠️  DO NOT commit .env to version control!
# ⚠️  Add .env to .gitignore

# =============================================================================
# HOW TO GET API KEYS
# =============================================================================
# 1. Moralis: https://moralis.io/ - Sign up and create a project
# 2. Infura: https://infura.io/ - Create account and get API key
# 3. BscScan: https://bscscan.com/apis - Register and create API key
# 4. TON: https://toncenter.com/ - Get API key for TON blockchain
# 5. WalletConnect: https://cloud.walletconnect.com/ - Create project

# =============================================================================
# TESTNET CONFIGURATION
# =============================================================================
# For testnet configuration, see .env.testnet.example
